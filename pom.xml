        <aspectj>1.9.22.1</aspectj>
      <!--  <jjwt>0.12.6</jjwt>-->
        <aliyun.sdk.oss>3.18.1</aliyun.sdk.oss>
        <jaxb-api>2.3.1</jaxb-api>
        <poi>5.4.0</poi>
        <mysql-connector-j>8.0.33</mysql-connector-j>
