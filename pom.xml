    <groupId>com.example</groupId>
    <artifactId>novel-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>novel-platform</name>
    <description>novel-platform</description>
    <packaging>pom</packaging>
    <modules>
        <module>novel-platform-pojo</module>
        <module>novel-platform-common</module>
        <module>novel-platform-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <lombok>1.18.36</lombok>
        <fastjson>2.0.54</fastjson>
        <commons.lang>2.6</commons.lang>
        <druid>1.2.24</druid>
